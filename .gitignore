# Nextflow run state
work/
.nextflow/
.nextflow.log*
nextflow_head.log
nextflow_head.err

# Pipeline outputs: symlinks into work/, about 0.5 TB per run; run records
results/0*/
results/pipeline_info/
results/_run_info/

# Per-sample data: never under version control
info/*.csv
info/*.tsv
results/selected_settings/

# Test runs (the synthetic input data in tests/data are tracked)
tests/work/
tests/results/
tests/runs/*/work/
tests/runs/*/results/
tests/runs/*/*.log

# Notebook, Python and editor leftovers
.ipynb_checkpoints/
__pycache__/
*.pyc
.mpl/
.vscode/
.DS_Store
