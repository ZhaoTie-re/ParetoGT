/*
 * ParetoGT: parameters, resources and profiles.
 *
 * Default: the SLURM cluster of the first application (partition gr10478b; resources through --rsc).
 * Profiles: local (every task on this host), test (synthetic data in tests/data, a small grid, local).
 * Every parameter can be set on the command line, e.g. --chromosomes 22 --dp 8,9 --outDir <dir>.
 */

params {
    // ---- Inputs: the WGS and array VCFs, or the matrices of an earlier run
    wgsDir         = null                          // one WGS VCF per chromosome, FORMAT GT, DP, GQ, AF
    callVcfSuffix  = '.vqc.af.gtnorm.vcf.gz'       // file name in wgsDir: <chr><suffix>
    trueVcf        = null                          // array VCF (the truth), FORMAT GT
    matrixDir      = null                          // instead of the VCFs: <run>/results/01.prepare_format_matrix
    sampleInfo     = "${projectDir}/info/jhrpv5.target_dp.csv"   // ID,Target_DP (15x / 30x)

    // ---- Threshold grid: comma-separated values; integer ranges as a-b
    chromosomes    = '1-22'
    dp             = '1-30'
    gq             = '10,20,30'
    laf            = '0.0,0.1,0.15,0.2,0.25,0.3'
    haf            = '1.0,0.9,0.85,0.8,0.75,0.7'

    // ---- Selection
    weights        = '1/7,1/6,1/5,1/4,1/3,1/2,1,2,3,4,5,6'   // W = weight on concordance : weight on miss rate
    adoptWeight    = '1/4'                                    // the knee at this W is marked as adopted in the figures

    // ---- Execution
    outDir         = "${projectDir}/results"
    publishMode    = 'symlink'          // 01-05 (about 0.5 TB for the full grid); summary, selection, figures are copied
    combosPerTask  = 36                 // threshold combinations per EVALUATE / MERGE_AND_SUMMARIZE task
    chromSummaries = true               // per-chromosome metrics (03)
    batchSize      = 1000               // variants per block in EVALUATE
    prepareThreads = 8
    evaluateThreads = 4
    exportThreads  = 8

    // ---- Tools (absolute paths: an activated conda env is not reliably first on PATH at this site)
    python         = '/home/b/b37974/anaconda3/envs/cteph_geno_pro/bin/python3'   // pandas, numpy, matplotlib, scipy, kneed
    bcftools       = '/home/b/b37974/bcftools/bcftools'
}

process {
    executor       = 'slurm'
    queue          = 'gr10478b'
    time           = '6d'
    errorStrategy  = { task.exitStatus in [137, 140, 143] && task.attempt <= 3 ? 'retry' : 'finish' }
    maxRetries     = 3

    // Resources only through --rsc (p: processes, t: threads, c: cores, m: memory, at most c x 4571M)
    withLabel: 'prepare' {
        clusterOptions = '--rsc p=1:t=1:c=8:m=18234M'
    }
    withLabel: 'evaluate' {
        clusterOptions = { task.attempt == 1 ? '--rsc p=1:t=4:c=4:m=18284M' : '--rsc p=1:t=4:c=8:m=36568M' }
    }
    withLabel: 'merge' {
        clusterOptions = {
            task.attempt == 1 ? '--rsc p=1:t=2:c=6:m=18234M' :
            task.attempt == 2 ? '--rsc p=1:t=2:c=8:m=27426M' : '--rsc p=1:t=2:c=10:m=36568M'
        }
    }
    withLabel: 'export' {
        clusterOptions = '--rsc p=1:t=8:c=8:m=36568M'
    }
    withLabel: 'small' {
        executor   = 'local'
    }
}

executor {
    queueSize = 20          // tasks submitted (or run) at once; lower it to leave room for other jobs
}

profiles {
    local {
        process.executor = 'local'
    }
    test {
        process.executor = 'local'
        params.wgsDir          = "${projectDir}/tests/data/wgs"
        params.callVcfSuffix   = '.test.vcf.gz'
        params.trueVcf         = "${projectDir}/tests/data/array/array.test.vcf.gz"
        params.sampleInfo      = "${projectDir}/tests/data/sample_info.csv"
        params.chromosomes     = '21,22'
        params.dp              = '2,4,6,8,10,12,14'
        params.gq              = '10,20,30'
        params.laf             = '0.0,0.2'
        params.haf             = '1.0,0.8'
        params.combosPerTask   = 12
        params.batchSize       = 100
        params.prepareThreads  = 2
        params.evaluateThreads = 2
        params.exportThreads   = 2
        params.outDir          = "${projectDir}/tests/results"
        params.publishMode     = 'copy'
    }
}

trace {
    enabled   = true
    overwrite = true
    file      = "${params.outDir}/pipeline_info/trace.txt"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outDir}/pipeline_info/report.html"
}
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outDir}/pipeline_info/timeline.html"
}

manifest {
    name            = 'ParetoGT'
    description     = 'Pareto-optimal genotype QC thresholds for WGS, calibrated against array genotypes'
    author          = 'Zhao Tie'
    mainScript      = 'main.nf'
    version         = '0.2.0'
    nextflowVersion = '>=25.04'
}
